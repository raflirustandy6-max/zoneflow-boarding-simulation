# ==============================================================================
# KONFIGURASI ENVIRONMENT BACKEND PYTHON ZONEFLOW (FASTAPI / UVICORN)
# ==============================================================================

# Host dan Port binding server Uvicorn (Cloud Run/Render otomatis menyuntikkan PORT)
ZONEFLOW_BACKEND_HOST="0.0.0.0"
ZONEFLOW_BACKEND_PORT=8001

# Daftar domain frontend yang diizinkan mengakses API melalui CORS (pisahkan dengan koma).
# Gunakan "*" untuk prototipe terbuka, atau batasi ke domain HTTPS frontend produksi Anda:
# Contoh: ZONEFLOW_CORS_ORIGINS="https://zoneflow-web.vercel.app,https://zoneflow.example.com"
ZONEFLOW_CORS_ORIGINS="*"

# Proteksi CPU & Memori untuk In-Memory Job Registry (EXHAUSTIVE_JOBS & GA_JOBS)
ZONEFLOW_MAX_CONCURRENT_JOBS=2
ZONEFLOW_MAX_RETAINED_JOBS=50
