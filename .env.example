# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# KONFIGURASI EKSEKUSI SIMULASI ZONEFLOW
# ==============================================================================
# Website ZoneFlow menjalankan model Python AZBO V2 (backend/app/azbo_core.py)
# secara langsung di browser melalui Pyodide 0.27.8 + Web Worker tanpa memerlukan
# VITE_API_BASE_URL atau VITE_BACKEND_URL.
#
# Konfigurasi di bawah ini hanya digunakan untuk pengujian backend lokal opsional.
VITE_API_BASE_URL="/api/v1"
VITE_BACKEND_URL=""

# Target proxy lokal saat menjalankan server Python lokal (`python3 backend/run_server.py`)
VITE_BACKEND_PROXY_TARGET="http://127.0.0.1:8001"

# ==============================================================================
# KONFIGURASI DEPLOYMENT BACKEND PYTHON (FASTAPI / UVICORN)
# ==============================================================================
ZONEFLOW_BACKEND_HOST="0.0.0.0"
ZONEFLOW_BACKEND_PORT=8001
# Daftar origin frontend yang diizinkan mengakses CORS (pisahkan dengan koma, atau "*" untuk publik)
# Contoh produksi: ZONEFLOW_CORS_ORIGINS="https://zoneflow.example.com,https://zoneflow-app.vercel.app"
ZONEFLOW_CORS_ORIGINS="*"
# Batas job optimasi berat (Exhaustive Search / GA) yang boleh berjalan serentak per instance
ZONEFLOW_MAX_CONCURRENT_JOBS=2
# Batas jumlah riwayat job optimasi selesai yang disimpan di memori proses
ZONEFLOW_MAX_RETAINED_JOBS=50


# REPLIKASI EVALUASI AKHIR AZBO V2
# Default frontend adalah 20 untuk demonstrasi eksploratif.
# Blueprint/Audit AZBO menganjurkan minimal 100 replikasi untuk audit hasil utama
# (disesuaikan ketelitian dan biaya komputasi); pekerjaan 100 replikasi mungkin lama.
# Tetapkan nilai ini SEBELUM build frontend; Vite membaca variabel pada build-time.
# VITE_AZBO_TEST_REPS=100
